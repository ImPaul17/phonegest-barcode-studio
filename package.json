{
  "name": "phonegest-barcode-studio",
  "version": "1.0.2",
  "private": true,
  "description": "Generador offline de códigos de barras para uso interno de PhoneGest",
  "author": "PhoneGest",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/ImPaul17/phonegest-barcode-studio.git"
  },
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/desktop.mjs",
    "desktop": "node scripts/desktop.mjs",
    "build": "tsc -b && vite build",
    "test": "node --test tests/*.test.mjs scripts/backend.test.mjs",
    "smoke": "npm run build && node scripts/desktop.mjs --smoke-test build/smoke",
    "test:ui": "node scripts/ui-test.mjs",
    "test:updates:ui": "node scripts/updater-ui-test.mjs",
    "test:pdf": "node tests/pdf-integration.mjs",
    "test:png": "node tests/png-integration.mjs",
    "notices": "node scripts/update-notices.mjs",
    "release:validate": "node scripts/release-validation.mjs",
    "package": "npm run build && electron-builder --win nsis portable --x64",
    "package:dir": "npm run build && electron-builder --win --dir --x64"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.0",
    "electron-updater": "^6.8.11",
    "jsbarcode": "^3.12.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "@zxing/library": "^0.21.3",
    "electron": "^45.2.3",
    "electron-builder": "^26.0.0",
    "js-yaml": "^5.5.0",
    "pdfjs-dist": "^6.5.438",
    "playwright": "^1.56.0",
    "typescript": "^5.9.0",
    "vite": "^6.3.0"
  }
}
